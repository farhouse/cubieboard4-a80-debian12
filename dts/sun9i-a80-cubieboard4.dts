/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	model = "Cubietech Cubieboard4";
	compatible = "cubietech,a80-cubieboard4", "allwinner,sun9i-a80";

	aliases {
		ethernet0 = "/soc@20000/ethernet@830000";
		serial0 = "/soc@20000/serial@7000000";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			cci-control-port = <0x02>;
			clock-frequency = <0xb71b00>;
			enable-method = "allwinner,sun9i-a80-smp";
			reg = <0x00>;
		};

		cpu@1 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			cci-control-port = <0x02>;
			clock-frequency = <0xb71b00>;
			enable-method = "allwinner,sun9i-a80-smp";
			reg = <0x01>;
		};

		cpu@2 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			cci-control-port = <0x02>;
			clock-frequency = <0xb71b00>;
			enable-method = "allwinner,sun9i-a80-smp";
			reg = <0x02>;
		};

		cpu@3 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			cci-control-port = <0x02>;
			clock-frequency = <0xb71b00>;
			enable-method = "allwinner,sun9i-a80-smp";
			reg = <0x03>;
		};

		cpu@100 {
			compatible = "arm,cortex-a15";
			device_type = "cpu";
			cci-control-port = <0x03>;
			clock-frequency = <0x112a880>;
			enable-method = "allwinner,sun9i-a80-smp";
			reg = <0x100>;
		};

		cpu@101 {
			compatible = "arm,cortex-a15";
			device_type = "cpu";
			cci-control-port = <0x03>;
			clock-frequency = <0x112a880>;
			enable-method = "allwinner,sun9i-a80-smp";
			reg = <0x101>;
		};

		cpu@102 {
			compatible = "arm,cortex-a15";
			device_type = "cpu";
			cci-control-port = <0x03>;
			clock-frequency = <0x112a880>;
			enable-method = "allwinner,sun9i-a80-smp";
			reg = <0x102>;
		};

		cpu@103 {
			compatible = "arm,cortex-a15";
			device_type = "cpu";
			cci-control-port = <0x03>;
			clock-frequency = <0x112a880>;
			enable-method = "allwinner,sun9i-a80-smp";
			reg = <0x103>;
		};
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
		clock-frequency = <0x16e3600>;
		arm,cpu-registers-not-fw-configured;
	};

	clocks {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0x20000000>;

		clk-24M {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x16e3600>;
			clock-output-names = "osc24M";
			phandle = <0x08>;
		};

		clk-32k {
			#clock-cells = <0x00>;
			compatible = "fixed-factor-clock";
			clock-div = <0x01>;
			clock-mult = <0x01>;
			clock-output-names = "osc32k";
			clocks = <0x04 0x00>;
			phandle = <0x07>;
		};

		mii-phy-tx-clk {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x17d7840>;
			clock-output-names = "mii_phy_tx";
			phandle = <0x05>;
		};

		gmac-int-tx-clk {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x7735940>;
			clock-output-names = "gmac_int_tx";
			phandle = <0x06>;
		};

		clk@800030 {
			#clock-cells = <0x00>;
			compatible = "allwinner,sun7i-a20-gmac-clk";
			reg = <0x800030 0x04>;
			clocks = <0x05 0x06>;
			clock-output-names = "gmac_tx";
			phandle = <0x0f>;
		};

		clk@8001410 {
			compatible = "allwinner,sun9i-a80-cpus-clk";
			reg = <0x8001410 0x04>;
			#clock-cells = <0x00>;
			clocks = <0x07 0x08 0x09 0x03 0x09 0x02>;
			clock-output-names = "cpus";
			phandle = <0x0a>;
		};

		clk-ahbs {
			compatible = "fixed-factor-clock";
			#clock-cells = <0x00>;
			clock-div = <0x01>;
			clock-mult = <0x01>;
			clocks = <0x0a>;
			clock-output-names = "ahbs";
			phandle = <0x0b>;
		};

		clk@800141c {
			compatible = "allwinner,sun8i-a23-apb0-clk";
			reg = <0x800141c 0x04>;
			#clock-cells = <0x00>;
			clocks = <0x0b>;
			clock-output-names = "apbs";
			phandle = <0x0c>;
		};

		clk@8001428 {
			compatible = "allwinner,sun9i-a80-apbs-gates-clk";
			reg = <0x8001428 0x04>;
			#clock-cells = <0x01>;
			clocks = <0x0c>;
			clock-indices = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x0c 0x0d 0x10 0x11 0x12 0x14>;
			clock-output-names = "apbs_pio", "apbs_ir", "apbs_timer", "apbs_rsb", "apbs_uart", "apbs_1wire", "apbs_i2c0", "apbs_i2c1", "apbs_ps2_0", "apbs_ps2_1", "apbs_dma", "apbs_i2s0", "apbs_i2s1", "apbs_twd";
			phandle = <0x40>;
		};

		clk@8001450 {
			reg = <0x8001450 0x04>;
			#clock-cells = <0x00>;
			compatible = "allwinner,sun4i-a10-mod0-clk";
			clocks = <0x07 0x08>;
			clock-output-names = "r_1wire";
		};

		clk@8001454 {
			reg = <0x8001454 0x04>;
			#clock-cells = <0x00>;
			compatible = "allwinner,sun4i-a10-mod0-clk";
			clocks = <0x07 0x08>;
			clock-output-names = "r_ir";
			phandle = <0x41>;
		};
	};

	display-engine {
		compatible = "allwinner,sun9i-a80-display-engine";
		allwinner,pipelines = <0x0d 0x0e>;
		status = "okay";
	};

	soc@20000 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0x20000000>;

		sram@20000 {
			compatible = "mmio-sram";
			reg = <0x20000 0x40000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x20000 0x40000>;

			smp-sram@1000 {
				compatible = "allwinner,sun9i-a80-smp-sram";
				reg = <0x1000 0x08>;
			};
		};

		ethernet@830000 {
			compatible = "allwinner,sun7i-a20-gmac";
			reg = <0x830000 0x1054>;
			interrupts = <0x00 0x52 0x04>;
			interrupt-names = "macirq";
			clocks = <0x09 0x61 0x0f>;
			clock-names = "stmmaceth", "allwinner_gmac_tx";
			resets = <0x09 0x11>;
			reset-names = "stmmaceth";
			snps,pbl = <0x02>;
			snps,fixed-burst;
			snps,force_sf_dma_mode;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x10>;
			phy-handle = <0x11>;
			phy-mode = "rgmii-id";
			phy-supply = <0x12>;

			mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				ethernet-phy@1 {
					reg = <0x01>;
					phandle = <0x11>;
				};
			};
		};

		usb@a00000 {
			compatible = "allwinner,sun9i-a80-ehci", "generic-ehci";
			reg = <0xa00000 0x100>;
			interrupts = <0x00 0x48 0x04>;
			clocks = <0x13 0x00>;
			resets = <0x13 0x00>;
			phys = <0x14>;
			phy-names = "usb";
			status = "okay";
		};

		usb@a00400 {
			compatible = "allwinner,sun9i-a80-ohci", "generic-ohci";
			reg = <0xa00400 0x100>;
			interrupts = <0x00 0x49 0x04>;
			clocks = <0x13 0x00 0x13 0x01>;
			resets = <0x13 0x00>;
			phys = <0x14>;
			phy-names = "usb";
			status = "okay";
		};

		phy@a00800 {
			compatible = "allwinner,sun9i-a80-usb-phy";
			reg = <0xa00800 0x04>;
			clocks = <0x13 0x05>;
			clock-names = "phy";
			resets = <0x13 0x03>;
			reset-names = "phy";
			status = "okay";
			#phy-cells = <0x00>;
			phy-supply = <0x15>;
			phandle = <0x14>;
		};

		usb@a01000 {
			compatible = "allwinner,sun9i-a80-ehci", "generic-ehci";
			reg = <0xa01000 0x100>;
			interrupts = <0x00 0x4a 0x04>;
			clocks = <0x13 0x02>;
			resets = <0x13 0x01>;
			phys = <0x16>;
			phy-names = "usb";
			status = "disabled";
		};

		phy@a01800 {
			compatible = "allwinner,sun9i-a80-usb-phy";
			reg = <0xa01800 0x04>;
			clocks = <0x13 0x07 0x13 0x0a 0x13 0x06>;
			clock-names = "phy", "hsic_12M", "hsic_480M";
			resets = <0x13 0x05 0x13 0x04>;
			reset-names = "phy", "hsic";
			status = "disabled";
			#phy-cells = <0x00>;
			phy_type = "hsic";
			phandle = <0x16>;
		};

		usb@a02000 {
			compatible = "allwinner,sun9i-a80-ehci", "generic-ehci";
			reg = <0xa02000 0x100>;
			interrupts = <0x00 0x4c 0x04>;
			clocks = <0x13 0x03>;
			resets = <0x13 0x02>;
			phys = <0x17>;
			phy-names = "usb";
			status = "okay";
		};

		usb@a02400 {
			compatible = "allwinner,sun9i-a80-ohci", "generic-ohci";
			reg = <0xa02400 0x100>;
			interrupts = <0x00 0x4d 0x04>;
			clocks = <0x13 0x03 0x13 0x04>;
			resets = <0x13 0x02>;
			phys = <0x17>;
			phy-names = "usb";
			status = "okay";
		};

		phy@a02800 {
			compatible = "allwinner,sun9i-a80-usb-phy";
			reg = <0xa02800 0x04>;
			clocks = <0x13 0x09 0x13 0x0a 0x13 0x08>;
			clock-names = "phy", "hsic_12M", "hsic_480M";
			resets = <0x13 0x07 0x13 0x06>;
			reset-names = "phy", "hsic";
			status = "okay";
			#phy-cells = <0x00>;
			phy-supply = <0x18>;
			phandle = <0x17>;
		};

		clock@a08000 {
			compatible = "allwinner,sun9i-a80-usb-clks";
			reg = <0xa08000 0x08>;
			clocks = <0x09 0x60 0x08>;
			clock-names = "bus", "hosc";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x13>;
		};

		cpucfg@1700000 {
			compatible = "allwinner,sun9i-a80-cpucfg";
			reg = <0x1700000 0x100>;
		};

		crypto@1c02000 {
			compatible = "allwinner,sun9i-a80-crypto";
			reg = <0x1c02000 0x1000>;
			interrupts = <0x00 0x50 0x04>;
			resets = <0x09 0x03>;
			clocks = <0x09 0x53 0x09 0x2e>;
			clock-names = "bus", "mod";
		};

		mmc@1c0f000 {
			compatible = "allwinner,sun9i-a80-mmc";
			reg = <0x1c0f000 0x1000>;
			clocks = <0x19 0x00 0x09 0x21 0x09 0x23 0x09 0x22>;
			clock-names = "ahb", "mmc", "output", "sample";
			resets = <0x19 0x00>;
			reset-names = "ahb";
			interrupts = <0x00 0x3c 0x04>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			pinctrl-names = "default";
			pinctrl-0 = <0x1a>;
			vmmc-supply = <0x1b>;
			bus-width = <0x04>;
			broken-cd;
		};

		mmc@1c10000 {
			compatible = "allwinner,sun9i-a80-mmc";
			reg = <0x1c10000 0x1000>;
			clocks = <0x19 0x01 0x09 0x24 0x09 0x26 0x09 0x25>;
			clock-names = "ahb", "mmc", "output", "sample";
			resets = <0x19 0x01>;
			reset-names = "ahb";
			interrupts = <0x00 0x3d 0x04>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			pinctrl-names = "default";
			pinctrl-0 = <0x1c>;
			vmmc-supply = <0x1d>;
			vqmmc-supply = <0x1e>;
			mmc-pwrseq = <0x1f>;
			bus-width = <0x04>;
			non-removable;
			broken-cd;
			disable-wp;
			no-mmc;
			cap-sd-highspeed;
			no-1-8-v;
		};

		mmc@1c11000 {
			compatible = "allwinner,sun9i-a80-mmc";
			reg = <0x1c11000 0x1000>;
			clocks = <0x19 0x02 0x09 0x27 0x09 0x29 0x09 0x28>;
			clock-names = "ahb", "mmc", "output", "sample";
			resets = <0x19 0x02>;
			reset-names = "ahb";
			interrupts = <0x00 0x3e 0x04>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			pinctrl-names = "default";
			pinctrl-0 = <0x20>;
			vmmc-supply = <0x1b>;
			bus-width = <0x08>;
			non-removable;
			broken-cd;
			disable-wp;
			no-sd;
			mmc-hs200-1.8v;
			cap-mmc-hw-reset;
		};

		mmc@1c12000 {
			compatible = "allwinner,sun9i-a80-mmc";
			reg = <0x1c12000 0x1000>;
			clocks = <0x19 0x03 0x09 0x2a 0x09 0x2c 0x09 0x2b>;
			clock-names = "ahb", "mmc", "output", "sample";
			resets = <0x19 0x03>;
			reset-names = "ahb";
			interrupts = <0x00 0x3f 0x04>;
			status = "disabled";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
		};

		clk@1c13000 {
			compatible = "allwinner,sun9i-a80-mmc-config-clk";
			reg = <0x1c13000 0x10>;
			clocks = <0x09 0x54>;
			resets = <0x09 0x04>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			clock-output-names = "mmc0_config", "mmc1_config", "mmc2_config", "mmc3_config";
			phandle = <0x19>;
		};

		interrupt-controller@1c41000 {
			compatible = "arm,gic-400";
			reg = <0x1c41000 0x1000 0x1c42000 0x2000 0x1c44000 0x2000 0x1c46000 0x2000>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			interrupts = <0x01 0x09 0xf04>;
			phandle = <0x01>;
		};

		cci@1c90000 {
			compatible = "arm,cci-400";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x1c90000 0x1000>;
			ranges = <0x00 0x1c90000 0x10000>;

			slave-if@4000 {
				compatible = "arm,cci-400-ctrl-if";
				interface-type = "ace";
				reg = <0x4000 0x1000>;
				phandle = <0x02>;
			};

			slave-if@5000 {
				compatible = "arm,cci-400-ctrl-if";
				interface-type = "ace";
				reg = <0x5000 0x1000>;
				phandle = <0x03>;
			};

			pmu@9000 {
				compatible = "arm,cci-400-pmu,r1";
				reg = <0x9000 0x5000>;
				interrupts = <0x00 0x86 0x04 0x00 0x86 0x04 0x00 0x86 0x04 0x00 0x86 0x04 0x00 0x86 0x04>;
			};
		};

		clock@3000000 {
			compatible = "allwinner,sun9i-a80-de-clks";
			reg = <0x3000000 0x30>;
			clocks = <0x09 0x37 0x09 0x36 0x09 0x6b>;
			clock-names = "mod", "dram", "bus";
			resets = <0x09 0x1d>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x21>;
		};

		display-frontend@3100000 {
			compatible = "allwinner,sun9i-a80-display-frontend";
			reg = <0x3100000 0x40000>;
			interrupts = <0x00 0x5d 0x04>;
			clocks = <0x21 0x15 0x21 0x00 0x21 0x0b>;
			clock-names = "ahb", "mod", "ram";
			resets = <0x21 0x00>;
			phandle = <0x0d>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x22>;
						phandle = <0x2a>;
					};
				};
			};
		};

		display-frontend@3140000 {
			compatible = "allwinner,sun9i-a80-display-frontend";
			reg = <0x3140000 0x40000>;
			interrupts = <0x00 0x5e 0x04>;
			clocks = <0x21 0x16 0x21 0x01 0x21 0x0c>;
			clock-names = "ahb", "mod", "ram";
			resets = <0x21 0x00>;
			phandle = <0x0e>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x23>;
						phandle = <0x2d>;
					};
				};
			};
		};

		display-backend@3200000 {
			compatible = "allwinner,sun9i-a80-display-backend";
			reg = <0x3200000 0x40000>;
			interrupts = <0x00 0x5f 0x04>;
			clocks = <0x21 0x1a 0x21 0x05 0x21 0x10>;
			clock-names = "ahb", "mod", "ram";
			resets = <0x21 0x05>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x24>;
						phandle = <0x2b>;
					};

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x25>;
						phandle = <0x2e>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x26>;
						phandle = <0x30>;
					};
				};
			};
		};

		display-backend@3240000 {
			compatible = "allwinner,sun9i-a80-display-backend";
			reg = <0x3240000 0x40000>;
			interrupts = <0x00 0x60 0x04>;
			clocks = <0x21 0x1b 0x21 0x06 0x21 0x11>;
			clock-names = "ahb", "mod", "ram";
			resets = <0x21 0x06>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x27>;
						phandle = <0x2c>;
					};

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x28>;
						phandle = <0x2f>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x29>;
						phandle = <0x32>;
					};
				};
			};
		};

		deu@3300000 {
			compatible = "allwinner,sun9i-a80-deu";
			reg = <0x3300000 0x40000>;
			interrupts = <0x00 0x5c 0x04>;
			clocks = <0x21 0x18 0x21 0x03 0x21 0x0e>;
			clock-names = "ahb", "mod", "ram";
			resets = <0x21 0x03>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x2a>;
						phandle = <0x22>;
					};
				};

				port@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x01>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x2b>;
						phandle = <0x24>;
					};

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x2c>;
						phandle = <0x27>;
