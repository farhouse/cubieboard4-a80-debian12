						regulator-min-microvolt = "", "\f5";
						regulator-max-microvolt = <0x10c8e0>;
						regulator-name = "vdd-cpub";
					};

					dcdcd {
						regulator-always-on;
						regulator-min-microvolt = "", "\f5";
						regulator-max-microvolt = <0x10c8e0>;
						regulator-name = "vdd-vpu";
					};

					dcdce {
						regulator-always-on;
						regulator-min-microvolt = <0x200b20>;
						regulator-max-microvolt = <0x200b20>;
						regulator-name = "vcc-bldo-codec-ldoin";
						phandle = <0x47>;
					};

					sw {
						regulator-name = "s_sw";
					};
				};
			};

			codec@e89 {
				compatible = "x-powers,ac100";
				reg = <0xe89>;

				codec {
					compatible = "x-powers,ac100-codec";
					interrupt-parent = <0x48>;
					interrupts = <0x00 0x09 0x08>;
					#clock-cells = <0x00>;
					clock-output-names = "4M_adda";
					phandle = <0x49>;
				};

				rtc {
					compatible = "x-powers,ac100-rtc";
					interrupt-parent = <0x46>;
					interrupts = <0x00 0x08>;
					clocks = <0x49>;
					#clock-cells = <0x01>;
					clock-output-names = "cko1_rtc", "cko2_rtc", "cko3_rtc";
					phandle = <0x04>;
				};
			};
		};
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "cubieboard4:green:usr";
			gpios = <0x4a 0x07 0x11 0x00>;
		};

		led-1 {
			label = "cubieboard4:red:usr";
			gpios = <0x4a 0x07 0x06 0x00>;
		};
	};

	vga-connector {
		compatible = "vga-connector";
		label = "vga";
		ddc-i2c-bus = <0x4b>;

		port {

			endpoint {
				remote-endpoint = <0x4c>;
				phandle = <0x4e>;
			};
		};
	};

	vga-dac {
		compatible = "corpro,gm7123", "adi,adv7123";
		vdd-supply = <0x1b>;

		ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;

				endpoint {
					remote-endpoint = <0x4d>;
					phandle = <0x36>;
				};
			};

			port@1 {
				reg = <0x01>;

				endpoint {
					remote-endpoint = <0x4e>;
					phandle = <0x4c>;
				};
			};
		};
	};

	wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <0x04 0x01>;
		clock-names = "ext_clock";
		reset-gpios = <0x48 0x00 0x02 0x01>;
		post-power-on-delay-ms = <0x32>;
		phandle = <0x1f>;
	};

	usb0-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb0-vbus";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x4f 0x01 0x00>;
		enable-active-high;
		regulator-always-on;
	};

	usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb1-vbus";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x4a 0x07 0x0e 0x00>;
		enable-active-high;
		regulator-always-on;
		phandle = <0x15>;
	};

	usb2-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb2-vbus";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x4a 0x07 0x0f 0x00>;
		enable-active-high;
		regulator-always-on;
		phandle = <0x18>;
	};

	ldoio0 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-wifi-ldoio0";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x4f 0x00 0x00>;
		enable-active-high;
		regulator-always-on;
	};
};
